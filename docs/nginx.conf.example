# Configuracao recomendada para o leandromacedo.dev no nginx (Hostinger)
#
# Copie o conteudo abaixo para o painel da Hostinger em:
#   "Avancado" > "Configuracoes do Nginx" (ou similar)
# ou inclua dentro do bloco `server { ... }` do dominio.
#
# Se preferir editar o vhost diretamente: cole o conteudo dentro do
# `server { listen 443 ssl; server_name leandromacedo.dev; ... }`.

# --- Compressao -----------------------------------------------------------
gzip on;
gzip_vary on;
gzip_comp_level 6;
gzip_min_length 256;
gzip_proxied any;
gzip_types
    text/plain
    text/css
    text/javascript
    text/xml
    application/javascript
    application/json
    application/xml
    application/xml+rss
    application/manifest+json
    image/svg+xml;

# --- Brotli (se o build do nginx no Hostinger tiver mod_brotli) -----------
# brotli on;
# brotli_comp_level 5;
# brotli_types text/plain text/css application/javascript application/json image/svg+xml;

# --- Cache de longo prazo para assets ------------------------------------
# Imagens, fontes e icones: 1 ano (sao versionados/imutaveis)
location ~* ^/assets/.*\.(webp|jpe?g|png|gif|ico|svg|woff2?|ttf|eot)$ {
    expires 1y;
    add_header Cache-Control "public, immutable" always;
    access_log off;
    try_files $uri =404;
}

# Imagens na raiz (favicons, apple-touch-icon)
location ~* ^/.+\.(ico|png|webmanifest)$ {
    expires 30d;
    add_header Cache-Control "public" always;
    access_log off;
}

# JS e CSS externos (caso volte a usar): 1 dia. Curto porque nao tem hash.
location ~* ^/assets/.*\.(css|js)$ {
    expires 1d;
    add_header Cache-Control "public" always;
}

# --- Cache curto para HTML (permite atualizar conteudo) ------------------
location / {
    expires 1h;
    add_header Cache-Control "public, must-revalidate" always;
    try_files $uri $uri/ $uri/index.html =404;
}

# --- Pagina de erro 404 personalizada ------------------------------------
# Sem isto, o nginx serve a pagina de erro padrao (feia) em vez do 404.html.
# Mantem o status HTTP 404 (correto para SEO) e serve o nosso /404.html.
error_page 404 /404.html;
location = /404.html {
    internal;   # so e servida em erros reais; remova esta linha p/ testar via /404.html
}

# --- Redirects de URLs antigas (sub-projetos movidos para /labs) ----------
# $request_uri preserva o subpath, ex.: /propostas/abc/ -> /labs/propostas/abc/
location /minesweeper/   { return 301 /labs$request_uri; }
location /casal-maromba/ { return 301 /labs$request_uri; }
location /propostas/     { return 301 /labs$request_uri; }

# --- Seguranca basica ----------------------------------------------------
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
