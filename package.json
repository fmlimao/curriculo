{
  "name": "curriculo",
  "private": true,
  "version": "1.0.0",
  "description": "Site do curriculo pessoal do Leandro Macedo",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./assets/css/tailwind.min.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./assets/css/tailwind.min.css --watch",
    "build:bundle": "node scripts/bundle-css.js",
    "build": "npm run build:css && npm run build:bundle",
    "pdf": "node scripts/gerar-cv.js"
  },
  "devDependencies": {
    "markdown-it": "^14.2.0",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^3.4.17"
  }
}
